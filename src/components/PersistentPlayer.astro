<aside id="persistent-player" class="persistent-player" aria-label="Music player" hidden>
  <div class="player-meta"><span class="player-mark">VJ.</span><div><small>NOW PLAYING</small><strong id="player-title">VonJay</strong></div></div>
  <iframe id="player-frame" title="SoundCloud music player" width="100%" height="80" allow="autoplay" loading="lazy"></iframe>
  <div class="player-actions"><a id="player-link" href="https://soundcloud.com/vonjay-music" target="_blank" rel="noopener noreferrer" aria-label="Open song on SoundCloud">SoundCloud ↗</a><button id="player-close" type="button" aria-label="Close player">×</button></div>
</aside>
<script>
  // Delegation survives Astro's client-side page swaps; the player itself persists.
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const play = target?.closest<HTMLButtonElement>('[data-play-track]');
    const player = document.querySelector<HTMLElement>('#persistent-player');
    if (!player) return;
    if (play) {
      const url = play.dataset.url;
      if (!url) return;
      const title = play.dataset.title || 'VonJay';
      const frame = player.querySelector<HTMLIFrameElement>('#player-frame')!;
      const params = new URLSearchParams({ url, color: '#c49a4c', auto_play: 'true', hide_related: 'true', show_comments: 'false', show_user: 'false', visual: 'false' });
      frame.src = `https://w.soundcloud.com/player/?${params}`;
      player.querySelector<HTMLElement>('#player-title')!.textContent = title;
      player.querySelector<HTMLAnchorElement>('#player-link')!.href = url;
      player.hidden = false;
      document.body.classList.add('player-open');
    }
    if (target?.closest('#player-close')) {
      player.querySelector<HTMLIFrameElement>('#player-frame')!.removeAttribute('src');
      player.hidden = true;
      document.body.classList.remove('player-open');
    }
  });
</script>
