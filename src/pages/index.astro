---
import Base from '../layouts/Base.astro';
import SoundCloudEmbed from '../components/SoundCloudEmbed.astro';
import RouteLine from '../components/RouteLine.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import { getReleases } from '../lib/content';
import { site } from '../site.config';

const releases = await getReleases();
const [latest] = releases;
const rest = releases.filter((r) => r.id !== latest?.id);
// Featured picks first, topped up with the newest releases so the row is always full.
const featured = [...rest.filter((r) => r.data.featured), ...rest.filter((r) => !r.data.featured)].slice(0, 3);
---
<Base>
  <section class="bg-midnight text-white">
    <div class="wrap grid gap-10 pb-16 pt-10 md:grid-cols-[1.1fr_1fr] md:items-end md:pt-16">
      <div>
        <p class="font-display text-xl font-bold text-brass">New from VonJay</p>
        <h1 class="mt-2 text-7xl md:text-9xl">{latest?.data.title}</h1>
        <div class="mt-8 max-w-md"><RouteLine /></div>
      </div>
      <div class="space-y-4">
        {latest && <SoundCloudEmbed url={latest.data.soundcloudUrl} title={latest.data.title} />}
        <a href={`/music/${latest?.id}`} class="text-mist hover:text-brass">The story behind the song</a>
      </div>
    </div>
  </section>

  <section class="wrap py-20">
    <h2 class="text-5xl md:text-6xl">Start here</h2>
    <div class="mt-8 grid gap-10 md:grid-cols-3">
      {featured.map((r) => (
        <div class="space-y-4">
          <ReleaseCard release={r} />
          <SoundCloudEmbed url={r.data.soundcloudUrl} title={r.data.title} compact />
        </div>
      ))}
    </div>
    <p class="mt-10"><a href="/music" class="btn btn-quiet">All music</a></p>
  </section>

  <section class="wrap grid gap-8 pb-20 md:grid-cols-[1fr_2fr]">
    <h2 class="text-5xl">Three cities, one sound</h2>
    <div class="prose-measure space-y-4">
      <p>{site.tagline}</p>
      <!-- TODO(jon): 2–3 sentences on the sound, in his words. -->
      <p><a href="/about">About VonJay</a></p>
    </div>
  </section>

  <EmailSignup />
</Base>
