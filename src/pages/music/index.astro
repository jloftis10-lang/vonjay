---
import Base from '../../layouts/Base.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { getReleases } from '../../lib/content';
const releases = await getReleases();
---
<Base title="Music" description="Listen to every VonJay release, newest first.">
  <section class="bg-midnight text-white py-16"><div class="wrap"><p class="eyebrow text-brass">THE CATALOG</p><h1 class="text-7xl md:text-[10rem] mt-4">THE MUSIC<span class="text-brass">.</span></h1><p class="text-xl text-mist mt-6 max-w-xl">Start anywhere. Stay for the next song.</p></div></section>
  <section class="wrap section-pad">
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {releases.map((r) => <ReleaseCard release={r} />)}
    </div>
  </section>
</Base>
