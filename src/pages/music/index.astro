---
import Base from '../../layouts/Base.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { getReleases } from '../../lib/content';
const releases = await getReleases();
---
<Base title="Music" description="Every VonJay release, newest first.">
  <section class="wrap py-16">
    <h1 class="text-7xl md:text-8xl">Music</h1>
    <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {releases.map((r) => <ReleaseCard release={r} />)}
    </div>
  </section>
</Base>
