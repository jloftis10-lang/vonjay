---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SoundCloudEmbed from '../../components/SoundCloudEmbed.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import { getReleases } from '../../lib/content';

export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((release) => ({ params: { slug: release.id }, props: { release } }));
}

const { release } = Astro.props;
const { title, date, soundcloudUrl, streaming, credits, cover } = release.data;
const artist = await getEntry(release.data.artist);
const { Content } = await render(release);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const links = [
  ['SoundCloud', soundcloudUrl], ['Spotify', streaming.spotify],
  ['Apple Music', streaming.appleMusic], ['YouTube', streaming.youtube],
].filter(([, href]) => href) as [string, string][];
---
<Base title={title} description={`${title} by ${artist?.data.name}`} image={cover}>
  <section class="bg-midnight text-white">
    <div class="wrap py-14">
      <p class="font-display text-xl font-bold text-brass">
        <a href="/about" class="no-underline hover:text-white">{artist?.data.name}</a>
      </p>
      <h1 class="mt-2 text-7xl md:text-9xl">{title}</h1>
      <p class="mt-4 text-mist">Released <time datetime={date.toISOString()}>{fmt.format(date)}</time></p>
      <div class="mt-8 max-w-3xl"><SoundCloudEmbed url={soundcloudUrl} title={title} /></div>
    </div>
  </section>
  <section class="wrap grid gap-12 py-16 md:grid-cols-[2fr_1fr]">
    <div class="prose-measure space-y-4"><Content /></div>
    <aside class="space-y-8">
      <div>
        <h2 class="text-3xl">Listen</h2>
        <ul class="mt-3 space-y-1">{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      {credits.length > 0 && (
        <div>
          <h2 class="text-3xl">Credits</h2>
          <dl class="mt-3 space-y-2">
            {credits.map((c) => <div><dt class="text-denim">{c.role}</dt><dd>{c.name}</dd></div>)}
          </dl>
        </div>
      )}
    </aside>
  </section>
  <EmailSignup />
</Base>
